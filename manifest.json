{
  "id": "org.meuaddon.driveproxy",
  "version": "1.0.0",
  "name": "Meus Filmes Drive Proxy",
  "description": "Filmes do meu Google Drive via Worker Proxy",
  "resources": [
    "catalog",
    "meta",
    "stream"
  ],
  "types": [
    "movie"
  ],
  "catalogs": [
    {
      "type": "movie",
      "id": "meus_filmes",
      "name": "Meus Filmes",
      "extra": [
        {
          "name": "genre",
          "options": [
            "Ação",
            "Aventura",
            "Animação",
            "Cinema TV",
            "Comédia",
            "Crime",
            "Documentário",
            "Drama",
            "Família",
            "Fantasia",
            "Ficção científica",
            "Guerra",
            "História",
            "Mistério",
            "Música",
            "Romance",
            "Terror",
            "Thriller"
          ],
          "isRequired": false
        }
      ]
    }
  ],
  "idPrefixes": [
    "tmdb:",
    "tt"
  ]
}
